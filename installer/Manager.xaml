<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH 会话树 · 插件管理器" Width="660" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#F2F6F5" Foreground="#132C2A" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#173A35"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9D8D4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="6" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value=".83"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#268772"/>
                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Surface" Property="Padding" Value="14,8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value=".45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="690">
    <StackPanel>
      <Border Background="#123D36" Padding="27,24">
        <StackPanel Orientation="Horizontal">
          <Border Width="46" Height="46" Background="#24574D" CornerRadius="11" Margin="0,3,15,0" VerticalAlignment="Top">
            <Canvas Width="24" Height="24">
              <Path Data="M5,4 L5,20 M5,12 L18,12 M5,20 L18,20" Stroke="#99DDCA" StrokeThickness="1.5"/>
              <Ellipse Width="6" Height="6" Fill="#C3F5E8" Canvas.Left="2" Canvas.Top="1"/>
              <Ellipse Width="6" Height="6" Fill="#C3F5E8" Canvas.Left="16" Canvas.Top="9"/>
              <Ellipse Width="6" Height="6" Fill="#C3F5E8" Canvas.Left="16" Canvas.Top="17"/>
            </Canvas>
          </Border>
          <StackPanel>
            <TextBlock Text="DSH 会话树" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="DeepSeek Harness 桌面插件管理器" Foreground="#C5E6DC" FontSize="13" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Margin="26,23,26,22">
        <Border Background="White" BorderBrush="#D7E4DF" BorderThickness="1" CornerRadius="10" Padding="17,14">
          <StackPanel>
            <TextBlock Text="DeepSeek Harness 安装位置" FontWeight="SemiBold" FontSize="14"/>
            <Grid Margin="0,9,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="DshPath" IsReadOnly="True" VerticalContentAlignment="Center" Padding="8,0"
                       BorderBrush="#C9D8D4" Background="#F8FBFA" AutomationProperties.Name="DeepSeek Harness 安装位置"/>
              <Button x:Name="Browse" Grid.Column="1" Margin="8,0,0,0" Content="选择程序…"/>
            </Grid>
            <TextBlock x:Name="DshStatus" Foreground="#46615B" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="White" BorderBrush="#D7E4DF" BorderThickness="1" CornerRadius="10" Padding="17,14" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="桌面配置" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock x:Name="PluginStatus" Margin="0,6,0,0" Foreground="#46615B"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#DDF2EA" CornerRadius="5" Padding="9,4" VerticalAlignment="Top">
              <TextBlock x:Name="BundleVersion" FontSize="12" Foreground="#145A47"/>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="Notice" Background="#E4EEEA" CornerRadius="7" Padding="11,9" Margin="0,12,0,0">
          <TextBlock x:Name="Status" FontSize="13" Foreground="#24483F"/>
        </Border>
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="Collapsed" Foreground="#18856C"/>
        <Expander x:Name="Details" Header="操作日志" Margin="0,10,0,0" Visibility="Collapsed">
          <TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Height="116" Padding="7" BorderBrush="#C9D8D4" Background="White" Margin="0,5,0,0"/>
        </Expander>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
          <Button x:Name="OpenDsh" Content="打开 DSH" DockPanel.Dock="Left"/>
          <Button x:Name="Install" Content="安装插件" DockPanel.Dock="Right"
                  Background="#145949" BorderBrush="#145949" Foreground="White" MinWidth="115"/>
          <Button x:Name="Uninstall" Content="卸载插件" DockPanel.Dock="Right" Margin="0,0,8,0"
                  Foreground="#85323B"/>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
